<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.androiddemo.ui.login.LoginFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_forecastFragment"
            app:destination="@id/forecastFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forecastFragment"
        android:name="com.example.androiddemo.ui.forecast.ForecastFragment"
        android:label="Flood Forecast"
        tools:layout="@layout/fragment_forecast">
        <action
            android:id="@+id/action_forecastFragment_to_placesFragment"
            app:destination="@id/placesFragment" />
        <action
            android:id="@+id/action_forecastFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/forecastFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/placesFragment"
        android:name="com.example.androiddemo.ui.places.PlacesFragment"
        android:label="Monitored Places"
        tools:layout="@layout/fragment_places">
        <action
            android:id="@+id/action_placesFragment_to_addPlaceFragment"
            app:destination="@id/addPlaceFragment" />
    </fragment>

    <fragment
        android:id="@+id/addPlaceFragment"
        android:name="com.example.androiddemo.ui.places.AddPlaceFragment"
        android:label="Add Place"
        tools:layout="@layout/fragment_add_place" />

</navigation>
